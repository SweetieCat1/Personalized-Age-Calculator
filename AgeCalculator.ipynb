   "source": [
    "# Personalized Age Calculator\n",
    "\n",
    "name = input(\"Enter your name: \")\n",
    "birth_year = int(input(\"Enter your birth year: \"))\n",
    "\n",
    "age = 2026 - birth_year\n",
    "\n",
    "print(\"Hello, \" + name + \"!\")\n",
    "print(\"You will turn\", age, \"years old in 2026.\")"
